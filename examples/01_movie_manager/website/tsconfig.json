{
    "compilerOptions": {
        "module": "ESNext",
        "target": "ES2020",
        "sourceMap": true,
        "moduleResolution": "bundler",
        "esModuleInterop": true,
        "allowSyntheticDefaultImports": true,
        "skipLibCheck": true,
        "strict": false,
        "outDir": "./dist"
    },
    "include": [
        "**/*.ts"
    ]
}
