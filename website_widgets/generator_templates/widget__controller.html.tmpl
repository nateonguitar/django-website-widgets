{% load static %}
{% comment %}
A widget shown more than once on a page needs a different id on each root, such as
__css_name__-{{ data.movie.id }}, passed to App.initController() the same way.
{% endcomment %}
<div id="__css_name__"
     class="__css_name__"
     data-label="{{ data.label }}">
    <p class="__css_name____label"></p>
</div>

<script type="module">
    import { App, __ClassName__Controller } from '{% static "main.js" %}';
    await App.initController(new __ClassName__Controller(), '#__css_name__');
</script>
