{% load static %}
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport"
          content="width=device-width, initial-scale=1.0">
    <title>{{ page.title }}</title>
    {# Every .scss file ts/main.ts imports, extracted by webpack into one stylesheet. #}
    <link rel="stylesheet"
          href="{% static 'bundled-styles.css' %}">
  </head>
  <body>
    {# Fills AppUrls before any controller runs. #}
    {{ children.app_urls }}

    {# Data every page shares goes on AppState, once, here. #}
    <script type="module">
      import { AppState } from '{% static "main.js" %}';
      AppState.siteName = '{{ page.site_name|escapejs }}';
    </script>

    {{ page_content_html }}
  </body>
</html>
