import { Controller } from "../../ts/website_widgets/controller";
import { AppState } from "../../ts/app-state";
import { AppUrls } from "../../ts/app-urls";

class Elements {
    greetingForm: HTMLFormElement | null = null;
    nameInput: HTMLInputElement | null = null;
    spinner: HTMLElement | null = null;
    greetingText: HTMLParagraphElement | null = null;

    public findIn(root: HTMLElement | null): void {
        if (!root) return;
        this.greetingForm = root.querySelector('#home-page__greeting-form');
        this.nameInput = root.querySelector('#home-page__name-input');
        this.spinner = root.querySelector('#home-page__spinner');
        this.greetingText = root.querySelector('#home-page__greeting');
    }
}

export class HomePageController extends Controller {
    private elements = new Elements();
    private loading = false;
    private greeting = '';

    public async initState(): Promise<void> {
        this.elements.findIn(this.rootElement);
        this.initializeListeners();
        // Data for this element alone is a data- attribute on its root, the element the
        // selector found.
        if (this.elements.nameInput) {
            this.elements.nameInput.value = this.rootElement?.dataset.defaultName ?? '';
        }
    }

    public setState(): void {
        const elements = this.elements;
        if (elements.spinner) {
            elements.spinner.hidden = !this.loading;
        }
        if (elements.greetingText) {
            elements.greetingText.textContent = this.greeting;
        }
    }

    protected initializeListeners(): void {
        this.elements.greetingForm?.addEventListener('submit', (event) => {
            event.preventDefault();
            this.fetchGreeting();
        });
    }

    private async fetchGreeting(): Promise<void> {
        const name = this.elements.nameInput?.value.trim() ?? '';
        if (!name) {
            this.greeting = 'Type a name first.';
            this.setState();
            return;
        }
        // The endpoint's URL arrives with a {name} placeholder for the controller to fill.
        const url = AppUrls.endpoint_greeting.replace('{name}', encodeURIComponent(name));
        this.loading = true;
        this.setState();
        try {
            const response = await fetch(url);
            if (response.ok) {
                const body = await response.json();
                // Data every page shares is on AppState, set by the document template.
                this.greeting = `${AppState.siteName} says: ${body.message}`;
            } else {
                this.greeting = `The server answered ${response.status}.`;
            }
        } catch {
            this.greeting = 'The request failed.';
        } finally {
            this.loading = false;
            this.setState();
        }
    }
}
